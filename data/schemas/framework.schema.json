{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "ai-infra/frameworks",
  "type": "object",
  "required": ["schema_version", "snapshot_date", "intro_notes", "training", "inference", "tooling", "recommendations", "shelf_life"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": 1 },
    "snapshot_date": { "type": "string", "pattern": "^\\d{4}-\\d{2}$" },
    "intro_notes": { "type": "array", "items": { "type": "string" } },
    "training": { "$ref": "#/definitions/projectList" },
    "inference": { "$ref": "#/definitions/projectList" },
    "tooling": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["purpose", "projects", "chapter_ref", "ascend_counterpart"],
        "additionalProperties": false,
        "properties": {
          "purpose": { "type": "string" },
          "projects": { "type": "string" },
          "chapter_ref": { "type": "string" },
          "ascend_counterpart": { "type": "string" },
          "sources": { "type": "array", "items": { "type": "string", "pattern": "^SRC-[A-Z0-9-]+$" } },
          "verification": { "enum": ["verified", "unverified"] },
          "review": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "reviewed_at": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
              "review_after_days": { "type": "integer", "minimum": 1 }
            }
          }
        }
      }
    },
    "recommendations": {
      "type": "object",
      "required": ["kind", "intro", "training_matrix", "inference_matrix", "veto_rules"],
      "additionalProperties": false,
      "properties": {
        "kind": { "const": "author_judgment" },
        "intro": { "type": "string" },
        "training_matrix": { "$ref": "#/definitions/matrix" },
        "inference_matrix": { "$ref": "#/definitions/matrix" },
        "veto_rules": { "type": "array", "items": { "type": "string" } }
      }
    },
    "shelf_life": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["info_type", "expected_shelf_life", "staleness_signal"],
        "additionalProperties": false,
        "properties": {
          "info_type": { "type": "string" },
          "expected_shelf_life": { "type": "string" },
          "staleness_signal": { "type": "string" }
        }
      }
    }
  },
  "definitions": {
    "projectList": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["layer", "name", "positioning", "chapter_ref", "ascend_counterpart", "verification"],
        "additionalProperties": false,
        "properties": {
          "layer": { "type": "string" },
          "name": { "type": "string" },
          "positioning": { "type": "string" },
          "chapter_ref": { "type": "string" },
          "ascend_counterpart": { "type": "string" },
          "sources": { "type": "array", "items": { "type": "string", "pattern": "^SRC-[A-Z0-9-]+$" } },
          "verification": { "enum": ["verified", "unverified"] },
          "review": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "reviewed_at": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
              "review_after_days": { "type": "integer", "minimum": 1 }
            }
          }
        }
      }
    },
    "matrix": {
      "type": "object",
      "required": ["scale_header", "rows"],
      "additionalProperties": false,
      "properties": {
        "scale_header": { "type": "array", "items": { "type": "string" } },
        "rows": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["scenario", "cells"],
            "additionalProperties": false,
            "properties": {
              "scenario": { "type": "string" },
              "cells": { "type": "array", "items": { "type": "string" } }
            }
          }
        }
      }
    }
  }
}
