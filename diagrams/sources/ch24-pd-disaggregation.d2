direction: down

classes: {
  compute: {
    style: {
      fill: "#EEF4FF"
      stroke: "#3B6FD4"
      font-color: "#1F2937"
      border-radius: 6
    }
  }
  storage: {
    style: {
      fill: "#E9F7EF"
      stroke: "#2E9E64"
      font-color: "#1F2937"
      border-radius: 6
    }
  }
  ctrl: {
    style: {
      fill: "#F3EEFF"
      stroke: "#7C5CD4"
      font-color: "#1F2937"
      border-radius: 6
    }
  }
  bottleneck: {
    style: {
      fill: "#FDECEC"
      stroke: "#D64545"
      font-color: "#1F2937"
      border-radius: 6
    }
  }
  plain: {
    style: {
      fill: "#FFFFFF"
      stroke: "#9CA3AF"
      font-color: "#1F2937"
      border-radius: 8
    }
  }
  ctrllink: {
    style: {
      stroke: "#7C5CD4"
      font-color: "#1F2937"
    }
  }
  commlink: {
    style: {
      stroke: "#D9822B"
      font-color: "#1F2937"
      stroke-width: 2
    }
  }
  badlink: {
    style: {
      stroke: "#D64545"
      font-color: "#D64545"
      stroke-dash: 4
    }
  }
}

gw: "网关 / 路由器" {
  class: ctrl
  width: 180
}

dom: "统一互联域(超节点,引用第 7 章)" {
  class: plain

  pp: "Prefill 池\n(compute-bound)" {
    class: plain
    style.stroke: "#3B6FD4"
    style.stroke-dash: 3
    p1: "Prefill 实例" {
      class: compute
      width: 190
    }
  }

  dp: "Decode 池(memory-bound)" {
    class: plain
    style.stroke: "#3B6FD4"
    style.stroke-dash: 3
    d1: "Decode 实例" {
      class: compute
      width: 190
    }
    kv1: "KV Cache\n约 320KB/token" {
      class: storage
      shape: cylinder
      width: 190
    }
    d1 -> kv1: "读写" {class: ctrllink}
  }

  pp.p1 -> dp.kv1: "KV 块,域内互联\n数百 GB/s,毫秒级" {class: commlink}
}

xd: "跨域(不要分离)" {
  class: plain
  style.stroke: "#D64545"
  style.stroke-dash: 3
  rd: "远端 Decode 池" {
    class: bottleneck
    width: 190
  }
}

gw -> dom.pp.p1: "请求 + 配对指令" {class: ctrllink}
gw -> dom.dp.d1: "decode 续接请求" {class: ctrllink}
dom.pp.p1 -> xd.rd: "KV 跨域传输\n带宽降一个数量级,尾延迟不可控" {class: badlink}
