grid-columns: 2
horizontal-gap: 100

classes: {
  compute: {
    style: {
      fill: "#EEF4FF"
      stroke: "#3B6FD4"
      font-color: "#1F2937"
      border-radius: 6
    }
  }
  comm: {
    style: {
      fill: "#FFF4E5"
      stroke: "#D9822B"
      font-color: "#1F2937"
      border-radius: 6
    }
  }
  bad: {
    style: {
      fill: "#FDECEC"
      stroke: "#D64545"
      stroke-width: 2
      font-color: "#1F2937"
      border-radius: 6
    }
  }
  plain: {
    style: {
      fill: "#FFFFFF"
      stroke: "#9CA3AF"
      font-color: "#1F2937"
      border-radius: 6
    }
  }
}

good: "好的对齐\n高频通信全在域内" {
  class: plain

  sn0: "超节点 0(64 卡)" {
    class: comm
    g1: "TP16 × EP4 组\nstage 0" {class: compute}
  }
  sn1: "超节点 1(64 卡)" {
    class: comm
    g2: "TP16 × EP4 组\nstage 1" {class: compute}
  }

  sn0.g1 -> sn1.g2: "激活 P2P\n每微批 ~17MB" {
    style: {
      stroke: "#D9822B"
      font-color: "#B45309"
    }
  }
  sn1.g2 -> sn0.g1: "梯度 AllReduce\n每步 1 次,可重叠" {
    style: {
      stroke: "#6B7280"
      stroke-dash: 4
      font-color: "#6B7280"
    }
  }
}

bad: "坏的对齐\nTP 组横跨域边界" {
  class: plain

  sn2: "超节点 2" {
    class: comm
    b1: "TP32 组\n前半" {class: bad}
  }
  sn3: "超节点 3" {
    class: comm
    b2: "TP32 组\n后半" {class: bad}
  }

  sn2.b1 <-> sn3.b2: "激活 AllReduce\n每层每微批,GB 级\n走 1/10 带宽断崖" {
    style: {
      stroke: "#D64545"
      stroke-width: 2
      font-color: "#D64545"
    }
  }
}
