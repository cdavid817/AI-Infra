direction: down

classes: {
  compute: {
    style: {
      fill: "#EEF4FF"
      stroke: "#3B6FD4"
      font-color: "#1F2937"
      border-radius: 6
    }
  }
  data: {
    style: {
      fill: "#E9F7EF"
      stroke: "#2E9E64"
      font-color: "#1F2937"
      border-radius: 6
    }
  }
  ctrl: {
    style: {
      fill: "#F3EEFF"
      stroke: "#7C5CD4"
      font-color: "#1F2937"
      border-radius: 6
    }
  }
  ext: {
    style: {
      fill: "#F3F4F6"
      stroke: "#9CA3AF"
      font-color: "#1F2937"
      border-radius: 6
    }
  }
  band: {
    style: {
      fill: "#FFFFFF"
      stroke: "#9CA3AF"
      font-color: "#1F2937"
      border-radius: 8
    }
  }
}

p7: "治理层 → 第七部分(30–31 章)" {
  class: band
  l7: "生命周期 / 容量 / 成本 / SLO" {class: ctrl}
}

p6: "应用平台层 → 第六部分(27–29 章)" {
  class: band
  l6: "网关 / Agent 运行时 / 可观测与评测" {class: ctrl}
}

p45: "负载层 → 第四、五部分(16–26 章)" {
  class: band
  direction: right
  l5: "推理系统:引擎 / 优化 / 服务化" {class: compute}
  l4: "训练系统:并行 / 显存 / 容错 / 后训练" {class: compute}
}

p3: "数据层 → 第三部分(13–15 章)" {
  class: band
  l3: "数据管道 / 存储与 checkpoint / 向量检索" {class: data}
}

p2: "资源调度层 → 第二部分(8–12 章)" {
  class: band
  l2: "K8s 设备管理 / 批调度 / 多租户 / 异构迁移" {class: ctrl}
}

p1: "软件栈与认知层 → 第一部分(1–7 章)" {
  class: band
  direction: right
  l1a: "CUDA / CANN 软件栈(5 章)" {class: compute}
  l1b: "模型的资源事实(3、6 章)" {class: compute}
}

p0: "物理层 → 第 4、7 章 + 第 31 章" {
  class: band
  l0: "加速卡 / 互联 / 机房功率散热" {class: ext}
}

p7 -> p6: "预算与 SLO 约束"
p6 -> p45: "请求流与评测卡点"
p45 -> p3: "样本流 / checkpoint 流"
p45 -> p2: "算力与同步需求"
p3 -> p2: "IO 带宽需求"
p2 -> p1: "驱动与运行时依赖"
p1 -> p0: "指令与显存操作"
p1 -> p45: "资源画像输入" {
  style: {
    stroke-dash: 4
    stroke: "#9CA3AF"
    font-color: "#6B7280"
  }
}
