{
  "name": "ai-infra-docs-tools",
  "version": "0.1.0",
  "private": true,
  "description": "AI-Infra 书稿文档工具链:链接、锚点与结构检查",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "docs:check:local-links": "node scripts/check-doc-links.mjs",
    "test:docs-tools": "node --test \"scripts/tests/**/*.test.mjs\"",
    "docs:check:evidence": "node scripts/validate-evidence.mjs",
    "docs:check:prompts": "node scripts/check-prompts.mjs",
    "docs:check:data": "node scripts/validate-data.mjs",
    "docs:generate": "node scripts/generate-appendices.mjs",
    "docs:check:drift": "node scripts/check-generated-drift.mjs",
    "docs:check:anchors": "node scripts/check-doc-anchors.mjs",
    "docs:check:structure": "node scripts/validate-chapters.mjs",
    "docs:check:external-links": "node scripts/check-external-links.mjs",
    "docs:check": "npm run test:docs-tools && npm run docs:check:local-links && npm run docs:check:anchors && npm run docs:check:structure && npm run docs:check:evidence && npm run docs:check:data && npm run docs:check:drift && npm run docs:check:prompts && npm run docs:check:images && npm run docs:check:manifest && npm run docs:check:labs && npm run docs:check:visuals && npm run docs:check:figure-regeneration",
    "docs:check:labs": "node scripts/validate-labs.mjs",
    "docs:check:images": "node scripts/validate-images.mjs",
    "docs:check:mermaid": "node scripts/check-mermaid.mjs",
    "docs:check:manifest": "node scripts/validate-manifest.mjs",
    "docs:check:visuals": "node scripts/validate-visuals.mjs",
    "docs:check:figure-regeneration": "node scripts/check-figure-regeneration.mjs",
    "docs:audit:prose": "node scripts/audit-prose-style.mjs",
    "docs:audit:visuals": "node scripts/audit-visuals.mjs",
    "docs:audit": "npm run docs:audit:prose && npm run docs:audit:visuals",
    "visuals:build": "node visuals/scripts/build-pilot-figures.mjs",
    "site:dev": "vitepress dev",
    "site:build": "vitepress build",
    "site:check": "node scripts/check-built-site.mjs"
  },
  "dependencies": {
    "ajv": "8.17.1",
    "github-slugger": "2.0.0",
    "remark-gfm": "4.0.1",
    "remark-parse": "11.0.0",
    "unified": "11.0.5",
    "yaml": "2.8.0"
  },
  "devDependencies": {
    "markdown-it-mathjax3": "4.3.2",
    "mermaid": "11.12.1",
    "vitepress": "1.6.4",
    "vitepress-plugin-mermaid": "2.0.17"
  }
}
